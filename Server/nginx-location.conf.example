# Include inside an existing HTTPS server{} for your chosen sync subdomain.
# Configure its real server_name and TLS certificate separately.
location / {
    client_max_body_size 1m;
    proxy_pass http://127.0.0.1:8765;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Overwrite incoming forwarding headers; do not trust a client-supplied value.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
}
